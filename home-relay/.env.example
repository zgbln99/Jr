# URL of your jrjr.pl VPS. Can be http://<IP>:8010 before HTTPS is set up,
# or https://jrjr.pl once nginx+certbot are done.
VPS_URL=http://51.75.65.32:8010

# Must match SESSION_SECRET in the VPS .env. That's the single secret
# that guards /api/internal/frame. Copy-paste it exactly.
SESSION_SECRET=wklej-dokładnie-to-co-masz-w-env-na-vps

# YouTube stream URL to grab from. Same as STREAM_URL on the VPS.
STREAM_URL=https://www.youtube.com/live/UNAqqHIPbWA

# How often to push a fresh frame, in minutes. 5 is a good default —
# matches the counter granularity widzów oglądają na stronie.
INTERVAL_MINUTES=5

# (optional) ms to wait after the <video> loads before screenshot.
# Bigger = more time for overlay to settle / ads to skip.
PLAYWRIGHT_WAIT=4000
