# URL of your jrjr.pl VPS. Can be http://<IP>:8010 before HTTPS is set up,
# or https://jrjr.pl once nginx+certbot are done.
VPS_URL=http://51.75.65.32:8010

# Must match SESSION_SECRET in the VPS .env. That's the single secret
# that guards /api/internal/frame. Copy-paste it exactly.
SESSION_SECRET=wklej-dokładnie-to-co-masz-w-env-na-vps

# YouTube stream URL to grab from. Same as STREAM_URL on the VPS.
STREAM_URL=https://www.youtube.com/live/UNAqqHIPbWA

# How often to push a fresh frame. Either INTERVAL_MINUTES or
# INTERVAL_SECONDS (INTERVAL_SECONDS wins if both are set).
# 5-minute cadence is stable, 10s gives near-real-time updates at the
# cost of more ticks. Minimum enforced at 3 s.
INTERVAL_MINUTES=5
# INTERVAL_SECONDS=10

# How often to re-resolve a fresh stream URL via yt-dlp, in minutes.
# YouTube-signed URLs stay valid ~6h but tying the refresh to a shorter
# window means we never get close to an expiry-driven failure. Also
# refreshes automatically when ffmpeg fails twice in a row.
MANIFEST_REFRESH_MINUTES=30

# Extra arguments passed to yt-dlp (space-separated). Normally empty.
# Useful if YouTube starts requiring specific player clients:
#   --extractor-args "youtube:player_client=mweb,android"
YT_EXTRA_ARGS=
