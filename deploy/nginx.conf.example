# jrjr.pl — nginx reverse-proxy in front of Next.js on 127.0.0.1:8010
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/jrjr.pl
#   sudo ln -s /etc/nginx/sites-available/jrjr.pl /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then issue certs:
#   sudo certbot --nginx -d jrjr.pl -d www.jrjr.pl
# Certbot rewrites this file to add the :443 server block + HTTP→HTTPS redirect.

server {
    server_name jrjr.pl www.jrjr.pl;
    listen 80;
    listen [::]:80;

    # Generous body size so admin can paste long copy / upload reasonable files.
    client_max_body_size 5M;

    # /api/internal/ is only called by the on-box OCR worker over 127.0.0.1.
    # Block public internet from ever hitting it — defense in depth on top of
    # the SESSION_SECRET check the endpoint already enforces.
    location /api/internal/ {
        return 404;
    }

    # Serve Next.js static assets with long cache (hashed filenames).
    location /_next/static/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
