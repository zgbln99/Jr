[Unit]
Description=jrjr.pl - Next.js web server
After=network.target

[Service]
Type=simple
User=jrjr
Group=jrjr
WorkingDirectory=/var/www/jrjr
EnvironmentFile=/var/www/jrjr/.env
# Port / HOSTNAME come from EnvironmentFile (.env). Default on Mikrus
# deploy: PORT=8010, HOSTNAME=127.0.0.1 (behind Mikrus proxy).
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start
Restart=always
RestartSec=5
# Modest memory cap — if Next.js ever leaks, systemd kills + restarts it
# rather than taking the whole Mikrus VPS down.
MemoryMax=512M
StandardOutput=journal
StandardError=journal
# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
