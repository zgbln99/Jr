# Admin credentials (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# iron-session cookie secret (min 32 characters, use `openssl rand -hex 32`)
SESSION_SECRET=replace-with-at-least-32-chars-of-random-hex

# SQLite database path (relative to project root)
DATABASE_PATH=./data/jrjr.db

# Port for the Next.js server (Mikrus: 8010; local dev: 3000)
PORT=8010
# Bind address — 127.0.0.1 when you front it with nginx / the Mikrus proxy,
# 0.0.0.0 when you expose the port directly.
HOSTNAME=127.0.0.1

# YouTube stream URL used by OCR worker
STREAM_URL=https://www.youtube.com/live/UNAqqHIPbWA

# Worker config
OCR_INTERVAL_MINUTES=5

# Counter data sources, comma-separated, tried in fallback order.
#   scrape      → GET the public donation URLs (e.g. Siepomaga) and
#                 parse them. Uses donation_url_1/2 from settings. Works
#                 without cookies, without YouTube.
#   playwright  → launch headless Chromium (deploy/install-playwright.sh),
#                 navigate to STREAM_URL with YT_COOKIES, screenshot the
#                 <video> element, OCR the admin-defined regions. Best
#                 choice when the live widget is the only source of the
#                 full total. Uses ~400 MB RAM per tick.
#   ocr         → legacy yt-dlp → ffmpeg path. Effectively dead on VPS
#                 IPs in 2026 (YouTube "Sign in / No video formats").
#                 Kept as a last resort.
# Default: try public scrape first, then Playwright against the stream.
COUNTER_SOURCES=playwright,scrape

# OCR engine (only relevant when `ocr` is in COUNTER_SOURCES).
#   "paddle"    best quality, ~500 MB RAM, requires deploy/install-paddle.sh
#   "tesseract" lighter, ~100 MB, just `apt install tesseract-ocr-pol`
OCR_ENGINE=paddle
# When OCR_ENGINE=paddle, point this at the venv interpreter that has
# paddleocr installed. Created by deploy/install-paddle.sh.
PADDLE_PYTHON=/var/www/jrjr/.venv/bin/python

# --- YouTube auth ---
# VPS IPs (including every byte of OVH) are blocklisted on Google side,
# so to capture frames from youtube.com we need BOTH:
#
#   1) a residential PROXY_URL so requests appear to come from a normal
#      home connection,
#   2) a cookies.txt exported from a browser logged into YouTube — to
#      skip the "verify you're not a bot" interstitial.
#
# Setup guide: deploy/PROXY.md
YT_COOKIES=/var/www/jrjr/.cookies/youtube.txt
# Extra args passed to yt-dlp (space-separated). Useful escape hatches:
#   --extractor-args "youtube:player_client=mweb,android"
#   --user-agent "Mozilla/5.0 (...)"
YT_EXTRA_ARGS=

# --- Residential proxy ---
# Format: http://USER:PASS@HOST:PORT (or http://HOST:PORT if no auth)
# Used by Playwright AND by the Tipply/Siepomaga scrapers.
# Recommended providers at our volume (~5 MB per 5-min tick):
#   IPRoyal residential — pay-as-you-go, $1.80/GB, no subscription
#   Webshare            — $3/mo for 100 MB residential bandwidth
#   Smartproxy          — $8.50/mo entry residential
# Leave empty to go direct (fine for most scrapers, will fail for
# YouTube from OVH).
PROXY_URL=

# Public site URL (for OG tags, absolute links)
NEXT_PUBLIC_SITE_URL=https://jrjr.pl
