# Admin credentials (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# iron-session cookie secret (min 32 characters, use `openssl rand -hex 32`)
SESSION_SECRET=replace-with-at-least-32-chars-of-random-hex

# SQLite database path (relative to project root)
DATABASE_PATH=./data/jrjr.db

# YouTube stream URL used by OCR worker
STREAM_URL=https://www.youtube.com/live/UNAqqHIPbWA

# OCR worker config
OCR_INTERVAL_MINUTES=5
# "paddle" (default, recommended) or "tesseract"
OCR_ENGINE=paddle

# Public site URL (for OG tags, absolute links)
NEXT_PUBLIC_SITE_URL=https://jrjr.pl
